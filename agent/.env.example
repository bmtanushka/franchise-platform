DATABASE_URL=
OPENAI_API_KEY=

# Lead-created notification email (app/email.py). If unset, it's logged
# instead of sent — fine for local dev, not for production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Same value as web's NEXT_PUBLIC_APP_URL — used to build the "View this
# lead" link in the notification email.
APP_PUBLIC_URL=

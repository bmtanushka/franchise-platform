DATABASE_URL=
AGENT_SERVICE_URL=
NEXT_PUBLIC_APP_URL=

# Auth (Auth.js/Clerk — pick one and fill in the relevant keys)
AUTH_SECRET=
# Required in production (Railway) — Auth.js's automatic host-detection
# (trustHost) picks up an incorrect x-forwarded-host behind Railway's
# proxy, which broke sign-out redirects. Not needed for local dev.
AUTH_URL=

# Password-reset emails (web/src/lib/email.ts). If unset, the reset link is
# just logged to the server console instead of emailed — fine for local
# dev, not for production.
RESEND_API_KEY=
# Defaults to onboarding@resend.dev (Resend's sandbox sender) if unset —
# fine for testing, but only delivers to the email on your Resend account
# until you verify a sending domain.
RESEND_FROM_EMAIL=
